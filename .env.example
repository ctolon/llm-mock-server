# Server network configuration
PORT=8000
HOST=0.0.0.0

# Optional API key enforcement (leave empty to allow any/no Bearer token)
MOCK_API_KEY=

# Allowed CORS origins (comma-separated, e.g. "https://app.example.com,http://localhost:3000" or "*")
MOCK_CORS_ORIGINS=*

# Simulated request latency in milliseconds (0 = no delay)
MOCK_LATENCY_MS=0

# Simulated SSE streaming token delay in milliseconds (0 = no delay)
MOCK_STREAM_DELAY_MS=0

# Always include reasoning_content in responses ("true" or "false")
MOCK_INCLUDE_REASONING=true

# vLLM engine version reported by /version and /server_info
MOCK_VLLM_VERSION=0.32.0

# Deterministic output mode ("true" or "false") - identical inputs yield identical outputs
MOCK_DETERMINISTIC=false

# Optional SQLite file path for multi-replica / multi-worker state persistence (e.g. /data/mock_state.db)
MOCK_STATE_DB_PATH=

# Optional chaos error injection rate (0.0 to 1.0)
MOCK_ERROR_RATE=0.0

# Container stdout streaming logging ("json" or "text", no file I/O)
MOCK_ENABLE_LOGGING=true
MOCK_LOG_FORMAT=json
MOCK_LOG_LEVEL=INFO

# Real-IP extraction, X-Request-ID & X-Process-Time-Ms observability middleware ("true" or "false")
MOCK_ENABLE_OBSERVABILITY=true

# Memory-safety caps for in-memory stores (item count, total bytes per store, max file bytes)
MOCK_MAX_STORE_SIZE=500
MOCK_MAX_STORE_BYTES=16777216
MOCK_MAX_FILE_BYTES=65536
